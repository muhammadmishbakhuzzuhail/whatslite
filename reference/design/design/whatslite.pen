                      "type": "text",
                      "id": "C22yP",
                      "name": "Title",
                      "fill": "$wl-text-primary",
                      "content": "Never fake data",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
