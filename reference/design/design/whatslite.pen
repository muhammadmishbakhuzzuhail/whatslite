                  "name": "Rule 2",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 5,
                  "children": [
                    {
                      "type": "text",
                      "id": "UvIja",
                      "name": "Number",
                      "fill": "$wl-accent",
                      "content": "02",
                      "fontFamily": "Inter",
                      "fontSize": 10,
                      "fontWeight": "700",
                      "letterSpacing": 0.14
                    },
                    {
                      "type": "text",
                      "id": "P71iuy",
                      "name": "Title",
                      "fill": "$wl-text-primary",
                      "content": "One source of colour",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "yO4tL",
                      "name": "Body",
                      "fill": "$wl-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "read theme.json into a Palette at startup. No hex literal in view code, no per-screen override. Dark mode is a flag, not a second UI.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "VvG7a",
                  "name": "Rule 3",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 5,
                  "children": [
                    {
                      "type": "text",
                      "id": "RIjmF",
                      "name": "Number",
                      "fill": "$wl-accent",
                      "content": "03",
                      "fontFamily": "Inter",
                      "fontSize": 10,
                      "fontWeight": "700",
                      "letterSpacing": 0.14
                    },
                    {
                      "type": "text",
                      "id": "kR8wh",
                      "name": "Title",
                      "fill": "$wl-text-primary",
                      "content": "The status contract",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "t7ZhR3",
                      "name": "Body",
                      "fill": "$wl-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Live = wire it. Coming soon = the control opens a toast, modal or placeholder, and the copy comes from section 03. Hidden = do not render it.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
