                      "type": "text",
                      "id": "sRt6T",
                      "name": "Body",
                      "fill": "$wl-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An empty list shows an empty state, not invented chats. A missing endpoint shows a placeholder, not sample rows pretending to be real.",
