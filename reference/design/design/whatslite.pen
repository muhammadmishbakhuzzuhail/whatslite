              "name": "Rules Column 1",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "frame",
                  "id": "tzRp8",
                  "name": "Rule 1",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 5,
                  "children": [
                    {
                      "type": "text",
                      "id": "isqNH",
                      "name": "Number",
                      "fill": "$wl-accent",
                      "content": "01",
                      "fontFamily": "Inter",
                      "fontSize": 10,
                      "fontWeight": "700",
                      "letterSpacing": 0.14
                    },
                    {
                      "type": "text",
                      "id": "TyaIk",
                      "name": "Title",
                      "fill": "$wl-text-primary",
                      "content": "Instance, never redraw",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "wYFk0",
                      "name": "Body",
                      "fill": "$wl-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Every row, bubble, chip, drawer and overlay in this file is a component. Build the app from those instances; if something is missing, add it here first.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
