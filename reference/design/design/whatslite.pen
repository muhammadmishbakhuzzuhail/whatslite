              "content": "02 · LOADING",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "600",
              "letterSpacing": 0.18
            },
            {
              "type": "text",
              "id": "TAZcV",
              "name": "Title",
              "fill": "$wl-text-primary",
              "content": "Do we need skeletons?",
              "fontFamily": "Inter",
              "fontSize": 26,
              "fontWeight": "700",
              "letterSpacing": -0.02
            },
            {
              "type": "text",
              "id": "I8Z7FV",
              "name": "Desc",
              "fill": "$wl-text-secondary",
              "textGrowth": "fixed-width",
              "width": 800,
              "content": "Yes — but only four of them, and only for first paint. A local desktop app fetches in single-digit milliseconds, so a skeleton on every transition would make it feel slower than it is. Use these rules.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "u4T7Dk",
          "name": "Skeleton Rules",
          "clip": true,
          "width": "fill_container",
          "fill": "$wl-bg-sidebar",
          "cornerRadius": 12,
          "layout": "vertical",
          "children": [
            {
              "type": "frame",
              "id": "WvJ1p",
              "name": "Rule / Show only above 200ms",
              "width": "fill_container",
              "stroke": "#00000010",
              "strokeWidth": {
                "bottom": 1
              },
              "strokeAlignment": "inner",
              "gap": 16,
              "padding": [
                12,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "f2vey",
                  "name": "Title",
                  "fill": "$wl-text-primary",
                  "content": "Show only above 200ms",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ChDaw",
                  "name": "Detail",
                  "fill": "$wl-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Delay the skeleton by 200ms. If the data lands sooner, the user never sees it and there is no flash.",
                  "lineHeight": 1.55,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
