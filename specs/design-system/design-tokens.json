{
  "meta": {
    "name": "WhatsApp macOS UI Reconstruction Design System",
    "version": "1.0.0",
    "date": "2026-10-29",
    "status": "proposed / visually reconstructed; not official WhatsApp tokens",
    "baseline": "macOS 2026 Tahoe-inspired, WhatsApp Mac Liquid Glass rollout",
    "units": "logical points (pt); 1x logical screenshot is 1512x982 pixels; backing pixels may be 2x on Retina"
